{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "household-subject-projection-v1",
  "title": "Minimal adult record projection for household composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_version","source_contract","analysis_id","systems","markers"],
  "properties": {
    "projection_version": {"const": "household-subject-projection-v1"},
    "source_contract": {"const": "analysis-v1"},
    "analysis_id": {"type": "string","minLength": 8,"maxLength": 128},
    "systems": {"type": "array","uniqueItems": true,"items": {"type": "string"}},
    "markers": {
      "type": "array",
      "items": {
        "type": "object","additionalProperties": false,
        "required": ["evidence_id","system","source_path","source_value","provenance_ref","epistemic_class"],
        "properties": {
          "evidence_id": {"type": ["string","null"]},
          "system": {"type": ["string","null"]},
          "source_path": {"type": ["string","null"]},
          "source_value": {"type": ["string","number","boolean","null"]},
          "provenance_ref": {"type": ["string","null"]},
          "epistemic_class": {"type": ["string","null"]}
        }
      }
    }
  }
}
