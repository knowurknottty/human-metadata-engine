{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Manual child-profile-v1",
  "type": "object",
  "required": [
    "contract_version",
    "subject_id",
    "subject_class",
    "age_band",
    "authority",
    "label",
    "interpretation_policy",
    "worksheets",
    "forbidden_inferences",
    "record_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "child-profile-v1"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^subj_[0-9a-f]{32}$"
    },
    "subject_class": {
      "const": "person_minor"
    },
    "age_band": {
      "enum": [
        "child",
        "adolescent"
      ]
    },
    "authority": {
      "type": "object"
    },
    "label": {
      "type": "string"
    },
    "interpretation_policy": {
      "const": "structure_only"
    },
    "worksheets": {
      "type": "object"
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
