{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentitySignature",
  "description": "Computed identity signature for any name or string",
  "type": "object",
  "$defs": {
    "symbolic_encoder_envelope": {
      "type": "object",
      "required": ["system", "phase", "status", "interpretation_level", "provenance", "data"],
      "properties": {
        "system": { "type": "string" },
        "phase": { "type": "string", "enum": ["phase_1", "phase_2", "phase_3", "phase_4", "structural"] },
        "status": { "type": "string", "enum": ["computed", "input_insufficient", "unavailable"] },
        "interpretation_level": { "type": "string", "enum": ["computed", "symbolic"] },
        "provenance": {
          "type": "object",
          "required": ["manifest_version", "convention", "source_ids", "input_mode"],
          "properties": {
            "manifest_version": { "type": "string" },
            "convention": { "type": "string" },
            "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "input_mode": { "type": "string" },
            "transliteration_profile": { "type": "string" }
          }
        },
        "data": { "type": "object" }
      }
    }
  },
  "required": [
    "original_text",
    "normalized_text",
    "tokens",
    "pythagorean",
    "linguistic",
    "provenance"
  ],
  "properties": {
    "original_text": {
      "type": "string",
      "description": "Original input text"
    },
    "normalized_text": {
      "type": "string",
      "description": "Uppercase, punctuation removed"
    },
    "tokens": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Split by spaces, hyphens, underscores"
    },
    "identity_type": {
      "type": "string",
      "enum": [
        "birth_name",
        "legal_name",
        "preferred_name",
        "nickname",
        "handle",
        "persona",
        "project",
        "agent",
        "system",
        "brand"
      ],
      "description": "Classification of this identity string"
    },
    "pythagorean": {
      "type": "object",
      "required": [
        "letter_values",
        "total",
        "reduced",
        "master_preserved",
        "vowels",
        "consonants",
        "soul_urge",
        "personality",
        "intensity_table",
        "karmic_lessons"
      ],
      "properties": {
        "letter_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["char", "value", "index"],
            "properties": {
              "char": { "type": "string" },
              "value": { "type": "integer", "minimum": 1, "maximum": 9 },
              "index": { "type": "integer" }
            }
          }
        },
        "total": { "type": "integer" },
        "reduced": { "type": "integer" },
        "master_preserved": {
          "type": ["integer", "null"],
          "enum": [11, 22, 33, null]
        },
        "vowels": { "type": "array" },
        "consonants": { "type": "array" },
        "soul_urge": { "type": "integer" },
        "personality": { "type": "integer" },
        "intensity_table": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "hidden_passion": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "karmic_lessons": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "linguistic": {
      "type": "object",
      "properties": {
        "letter_count": { "type": "integer" },
        "token_count": { "type": "integer" },
        "vowel_count": { "type": "integer" },
        "consonant_count": { "type": "integer" },
        "vowel_ratio": { "type": "number" }
      }
    },
    "encoders": {
      "type": "object",
      "description": "Legacy encoder payloads plus provenance-aware roadmap envelopes.",
      "properties": {
        "kabbalah_tree_of_life": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "sacred_geometry": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "alchemical_transformation": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "sumerian_sexagesimal": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "hermetic_principles": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "tarot": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "babylonian_planetary": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "hermes_thoth_nabu": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "solomonic": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "arabic_abjad": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "chinese": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "egyptian": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "vedic_jyotish": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "mayan_tzolkin": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "cuneiform_magic": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "elder_futhark": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "ogham": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "egyptian_maat": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "mandaean_duodecimal": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "tartaria_architecture": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "indus_valley": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "unicode_codepoint": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "apollonius": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "temporal_numerology": { "$ref": "#/$defs/symbolic_encoder_envelope" },
        "esoteric_bridge": { "$ref": "#/$defs/symbolic_encoder_envelope" }
      },
      "additionalProperties": { "type": "object" }
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "archetypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "interpretation_level": {
          "type": "string",
          "enum": ["computed", "symbolic", "inferred", "speculative"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "confidence"],
      "properties": {
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "user_confirmed": { "type": "boolean" }
      }
    }
  }
}
