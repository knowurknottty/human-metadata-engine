{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentitySignature",
  "description": "Computed identity signature for any name or string",
  "type": "object",
  "required": [
    "original_text",
    "normalized_text",
    "tokens",
    "pythagorean",
    "linguistic",
    "provenance"
  ],
  "properties": {
    "original_text": {
      "type": "string",
      "description": "Original input text"
    },
    "normalized_text": {
      "type": "string",
      "description": "Uppercase, punctuation removed"
    },
    "tokens": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Split by spaces, hyphens, underscores"
    },
    "identity_type": {
      "type": "string",
      "enum": [
        "birth_name",
        "legal_name",
        "preferred_name",
        "nickname",
        "handle",
        "persona",
        "project",
        "agent",
        "system",
        "brand"
      ],
      "description": "Classification of this identity string"
    },
    "pythagorean": {
      "type": "object",
      "required": [
        "letter_values",
        "total",
        "reduced",
        "master_preserved",
        "vowels",
        "consonants",
        "soul_urge",
        "personality",
        "intensity_table",
        "karmic_lessons"
      ],
      "properties": {
        "letter_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["char", "value", "index"],
            "properties": {
              "char": { "type": "string" },
              "value": { "type": "integer", "minimum": 1, "maximum": 9 },
              "index": { "type": "integer" }
            }
          }
        },
        "total": { "type": "integer" },
        "reduced": { "type": "integer" },
        "master_preserved": {
          "type": ["integer", "null"],
          "enum": [11, 22, 33, null]
        },
        "vowels": { "type": "array" },
        "consonants": { "type": "array" },
        "soul_urge": { "type": "integer" },
        "personality": { "type": "integer" },
        "intensity_table": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "hidden_passion": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "karmic_lessons": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "linguistic": {
      "type": "object",
      "properties": {
        "letter_count": { "type": "integer" },
        "token_count": { "type": "integer" },
        "vowel_count": { "type": "integer" },
        "consonant_count": { "type": "integer" },
        "vowel_ratio": { "type": "number" }
      }
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "archetypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "interpretation_level": {
          "type": "string",
          "enum": ["computed", "symbolic", "inferred", "speculative"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "confidence"],
      "properties": {
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "user_confirmed": { "type": "boolean" }
      }
    }
  }
}
