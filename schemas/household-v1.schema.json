{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Manual household-v1",
  "type": "object",
  "required": [
    "contract_version",
    "household_id",
    "composition",
    "primary_subject_id",
    "subjects",
    "requested_dimensions"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "household-v1"
    },
    "household_id": {
      "type": "string",
      "pattern": "^hh_[0-9a-f]{24}$"
    },
    "composition": {
      "enum": [
        "pair",
        "household"
      ]
    },
    "primary_subject_id": {
      "type": "string",
      "pattern": "^subj_[0-9a-f]{32}$"
    },
    "requested_dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "composition_scope",
          "role_presence",
          "declared_relationship",
          "input_readiness",
          "system_availability",
          "evidence_state",
          "same_system_observations"
        ]
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "subject_role",
          "subject_class",
          "membership",
          "record_contract",
          "record_digest",
          "record_state",
          "authority"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^subj_[0-9a-f]{32}$"
          },
          "subject_role": {
            "enum": [
              "primary",
              "partner",
              "adult_family",
              "child",
              "pet",
              "reference"
            ]
          },
          "subject_class": {
            "enum": [
              "person_adult",
              "person_minor",
              "nonhuman_animal",
              "historical_reference"
            ]
          },
          "membership": {
            "enum": [
              "member",
              "context_only"
            ]
          },
          "record_contract": {
            "enum": [
              "analysis-v1",
              "child-profile-v1",
              "pet-profile-v1",
              "historical-reference-v1"
            ]
          },
          "record_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "record_state": {
            "enum": [
              "resolved",
              "stale",
              "unresolved"
            ]
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "attestation_version"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "self_attested",
                  "adult_consent_attested",
                  "guardian_attested",
                  "owner_attested",
                  "public_source"
                ]
              },
              "attestation_version": {
                "const": "authority-v1"
              }
            }
          }
        }
      }
    }
  }
}
