{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entitlement-v1",
  "title": "Signed household entitlement claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","scope","household_id","subject_limit","issued_at","expires_at","jti"],
  "properties": {
    "schema_version": {"const": "entitlement-v1"},
    "scope": {"const": "household"},
    "household_id": {"type": "string","pattern": "^hh_[0-9a-f]{24}$"},
    "subject_limit": {"type": "integer","minimum": 1,"maximum": 7},
    "issued_at": {"type": "integer","minimum": 0},
    "expires_at": {"type": "integer","minimum": 1},
    "jti": {"type": "string","minLength": 16,"maxLength": 128}
  }
}
