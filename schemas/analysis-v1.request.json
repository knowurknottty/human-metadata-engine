{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity Resonance AnalysisRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "mode": {"type": "string", "enum": ["data", "magic"], "default": "data"},
    "subject_type": {"type": "string", "enum": ["self", "reference"], "default": "self"},
    "as_of_year": {"type": "integer", "minimum": 1},
    "birth": {"$ref": "#/$defs/birth"},
    "psychology": {"$ref": "#/$defs/psychology"},
    "lineage_surnames": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "observations": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/observation"}},
    "constellation": {"type": "object"}
  },
  "$defs": {
    "birth": {
      "type": "object",
      "required": ["year", "month", "day", "timezone_offset", "lat", "lon"],
      "properties": {
        "year": {"type": "integer"}, "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "day": {"type": "integer", "minimum": 1, "maximum": 31},
        "hour": {"type": "integer", "minimum": 0, "maximum": 23},
        "minute": {"type": "integer", "minimum": 0, "maximum": 59},
        "timezone_offset": {"type": "number", "minimum": -14, "maximum": 14},
        "time_accuracy": {"type": "string", "enum": ["unknown", "hour_only", "approximate", "exact", "provided"]},
        "location": {"type": "string", "maxLength": 120},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "psychology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "big_five": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "mbti": {"type": "string", "pattern": "^[EI][NS][TF][JP]$"},
        "enneagram": {"type": "object", "additionalProperties": false, "properties": {"type": {"type": "integer", "minimum": 1, "maximum": 9}, "wing": {"type": ["integer", "null"], "minimum": 1, "maximum": 9}}},
        "attachment": {"type": "string", "enum": ["secure", "anxious", "avoidant", "disorganized", "fearful_avoidant"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "source": {"type": "string", "maxLength": 80},
        "confidence": {"type": "string", "enum": ["unrated", "low", "medium", "high"]},
        "occurred_at": {"type": ["string", "null"], "maxLength": 40}
      }
    }
  }
}
